{
  "name": "spark-order-iq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SPARK ORDER IQ — offer decision support for Walmart Spark drivers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "deploy": "tsc -b --noEmit && vite build --outDir ../docs/spark-order-iq --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
