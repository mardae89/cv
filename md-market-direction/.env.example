# ─────────────────────────────────────────────────────────────────────────────
# MD MARKET DIRECTION — environment
#
# Every value here is read SERVER-SIDE ONLY. No key is ever exposed to the
# browser. The application runs with none of these set: it starts in a clearly
# labelled DEMO DATA MODE and says so on every screen.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED IN PRODUCTION — signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ── Market data ──────────────────────────────────────────────────────────────
# THE ONE VARIABLE THAT TURNS ON REAL PRICES.
# Free key: https://twelvedata.com/pricing (free tier = 8 requests/min, 800/day).
# Without it the demo engine is used and every quote and candle is flagged demo.
TWELVE_DATA_API_KEY=

# Which markets get live data. Live data is metered, so the universe is split
# deliberately: these symbols are fetched live, everything else stays on demo
# data and is labelled as such on every card. Defaults to a core twelve that
# fits inside the free tier. Comma separated, using MD's own symbols.
# MD_LIVE_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,XAU/USD,XAG/USD,SPX,NDX,BTC/USD,ETH/USD,WTI,AAPL,NVDA

# Request budget. The app refuses a call before making it once these are hit, so
# an exhausted plan degrades to demo data with an explanation instead of 429s.
# Match these to your plan.
# MD_API_PER_MINUTE=8
# MD_API_PER_DAY=800

# How long live data is held before refetching. Longer windows mean fewer
# requests. Each screen always shows the true age of what it displays.
# MD_INTRADAY_TTL_MS=900000     # 15 minutes
# MD_DAILY_TTL_MS=21600000      # 6 hours
# MD_QUOTE_TTL_MS=60000         # 1 minute

# ── Access ───────────────────────────────────────────────────────────────────
# true = the market pages open without a login. Watchlists, alerts, the journal
# and the AI analyst still require an account, so public mode can never run up
# an LLM bill or leak one visitor's data to another.
MD_PUBLIC_MODE=true
# Tier granted to anonymous viewers in public mode: free | pro | elite
# MD_PUBLIC_TIER=elite

# ── News ─────────────────────────────────────────────────────────────────────
# Raw headlines are classified into themes + sentiment by the configured LLM.
# With no LLM, articles are returned as "unclassified" and the News category is
# reported as unavailable rather than guessed. Implements NewsProvider.
NEWS_API_KEY=

# ── Economic calendar ────────────────────────────────────────────────────────
# Implements EconomicCalendarProvider.
FMP_API_KEY=

# ── AI (the Market Analyst, the WHY explanations and news classification) ────
# Either provider works; Anthropic takes precedence when both are set. With
# neither, the deterministic explanation engine answers from the same structured
# analysis data — the feature degrades, it does not break.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=claude-sonnet-5

# ── Payments ─────────────────────────────────────────────────────────────────
# Without these, plan changes run through a clearly labelled demo upgrade so the
# paywall → upgrade → entitlement flow is testable end to end.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# ── Storage ──────────────────────────────────────────────────────────────────
# The default store is a JSON file under ./data. prisma/schema.prisma is the
# PostgreSQL production target — implement the same store interface on Prisma and
# nothing above src/lib/db/store.ts changes.
# MD_DATA_DIR=./data
# DATABASE_URL=postgresql://user:password@localhost:5432/md_market_direction
